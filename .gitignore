.env
__pycache__/
*.pyc
.venv/
.DS_Store
/results/

# harness build worktrees (scratch, recreated per run)
.claude/worktrees/
e8_*.log
sweep_*.log
.cache/

# probe run artefacts (30 Sep 2026): server/run logs, pids, nohup, adapters, held-out jsonl —
# the RESULTS.md and the results/*.json are the evidence; these are not (tracked ones stay tracked)
# (earlier probes DO commit evidence logs such as record-*.log — so only the noisy classes are ignored here)
docs/probes/**/server*.log
docs/probes/**/run*.log
docs/probes/**/*.pid
docs/probes/**/nohup.out
docs/probes/**/pull.log
docs/probes/**/adapters-*/
docs/probes/**/data/test.jsonl
docs/probes/**/.stamp
docs/probes/**/.*_done

# K0 call audio (licence CC-BY-SA-4.0, re-pullable from MANIFEST.json); never committed
docs/probes/k-asr-*/data/

# per-client data (2026-11-01): real client data never enters git; only the synthetic _fake-* fixtures do
clients/*
!clients/_fake-*/
clients/_fake-*/retrieval/

# wilco package build output (W5)
*.egg-info/
/build/
/dist/
